# Fabric identity and target. No credentials belong in this file.
FABRIC_WORKSPACE_ID=
FABRIC_WORKSPACE_NAME=Fabric-Custom-Wheel-POC
FABRIC_CAPACITY_ID=

FABRIC_ENVIRONMENT_NAME=Custom-Wheel-Spark-Env
FABRIC_SPARK_RUNTIME=1.3
FABRIC_LAKEHOUSE_NAME=CustomWheelPOCLakehouse
FABRIC_PIPELINE_NAME=PL_Custom_Wheel_POC

# Use "sample" for the included dependency-free wheel. To validate your own
# wheel, use "custom" and set the fields below. Paths may be repo-relative.
WHEEL_SOURCE=sample
WHEEL_PATH=
WHEEL_IMPORT_NAME=
WHEEL_DISTRIBUTION_NAME=
# Optional function invoked with one string argument, using module:attribute syntax.
# Leave empty for import-only validation. The sample default is
# fabric_custom_wheel_sample:transform.
WHEEL_TEST_CALLABLE=

ENABLE_RESOURCE_CREATION=true
ENABLE_SCALE_TEST=false
SCALE_PROFILE=smoke
# Execution is opt-in so provisioning can be reviewed before Spark costs begin.
RUN_SMOKE_TEST=false
SET_WORKSPACE_DEFAULT_ENVIRONMENT=false
FABRIC_POLL_SECONDS=15
FABRIC_OPERATION_TIMEOUT_SECONDS=1800
